# VPP Phase 2 Simulation Configuration

# Phase 1 (Bottle Master) Configuration
VPP_MASTER_URL=http://localhost:8080
VPP_MASTER_API_KEY=
VPP_MASTER_TIMEOUT=30
VPP_MASTER_MAX_RETRIES=3
VPP_MASTER_RETRY_DELAY=5

# Synchronization Configuration
VPP_SYNC_INTERVAL=5

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/vpp_phase2

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False
FLASK_PORT=5000

# Prometheus Configuration
PROMETHEUS_PORT=9090
