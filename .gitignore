# Python - Cache and compiled files only
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing - Cache only, keep test files
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# Database - Local instances only
*.db
*.sqlite
*.sqlite3

# Logs - Runtime logs only
logs/
*.log

# Environment - Local config only
.env
.env.local

# OS
.DS_Store
Thumbs.db

# Build artifacts - Keep source, ignore build output
dist/
build/
*.egg-info/
*.egg

# Node modules (if any)
node_modules/
