# VPP Phase 2 Simulation Framework Environment Configuration
# Local Development Deployment

# Environment
ENV=development
DEBUG=False
TESTING=False

# Database (Docker Compose)
DATABASE_URL=postgresql://vpp_user:vpp_password@localhost:5432/vpp_phase2_sim
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# Redis (Docker Compose)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/vpp_phase2_sim.log

# Simulation Parameters
SIMULATION_TIME_STEP=1.0
MAX_DEVICES=10000
MAX_SCENARIOS=100
METRICS_RETENTION_DAYS=30

# Performance
POWER_FLOW_TIMEOUT_MS=500
DASHBOARD_UPDATE_INTERVAL_MS=500
METRICS_AGGREGATION_INTERVAL_S=60

# API
API_HOST=0.0.0.0
API_PORT=8080
API_WORKERS=4

# Prometheus Metrics
PROMETHEUS_ENABLED=True
PROMETHEUS_PORT=8081

# VPP Master Integration
VPP_MASTER_URL=http://localhost:8000
VPP_MASTER_API_KEY=

# Network Simulation
NETWORK_SIMULATION_ENABLED=True
DEFAULT_LATENCY_MS=20
DEFAULT_PACKET_LOSS_RATE=0.01
